#!/usr/bin/expect -f

set timeout 30
set host "200.141.5.200"
set user "root"
set password "Possible@007"

spawn ssh -o StrictHostKeyChecking=no "$user@$host"

expect {
    "*password:" {
        send "$password\r"
        exp_continue
    }
    "*# " {
        # Logged in successfully
    }
}

send "journalctl -u cremson-backend --no-pager | grep -C 1 -i \"create_shipment HTTP\"\r"
expect "*# "

send "exit\r"
expect eof
